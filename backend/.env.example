# Copy to backend/.env for local runs. On Render, set these in Environment.
PINECONE_API_KEY=
GEMINI_API_KEY=
GITHUB_TOKEN=
ADMIN_TOKEN=change-me-long-random-string

# Comma-separated frontend URLs allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173

# Read your project's real limits in Google AI Studio and put them here
GEMINI_RPM=10
GEMINI_RPD=250
EXPECTED_DAILY_USERS=25

# Replace after running scripts/measure_repos.py (see README "Numbers")
CHARS_PER_TOKEN_EST=2.5
MAX_FILE_BYTES=100000
MAX_REPO_TOKENS=250000
TOP_K=6
